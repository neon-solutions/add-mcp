---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";

import Footer from "../components/Footer.astro";
import HeaderBadges from "../components/HeaderBadges.astro";

const { config } = data;

const agentNames = [
  "Claude Code",
  "Codex",
  "Cursor",
  "OpenCode",
  "VS Code",
  "Antigravity",
  "Claude Desktop",
  "Cline",
  "Gemini CLI",
  "GitHub Copilot CLI",
  "Goose",
  "MCPorter",
  "Windsurf",
  "Zed",
];

const features = [
  {
    title: "One command, every agent",
    body: "Detects the agents in your project or machine, and writes the right config shape to each one — JSON, YAML, or TOML.",
  },
  {
    title: "Find servers from the terminal",
    body: "add-mcp find searches the registry and installs a match, prompting for required env vars and headers along the way.",
  },
  {
    title: "A TypeScript SDK",
    body: "Building your own CLI? upsertServer() gives your tool the same battle-tested install flow, agents and formats included.",
  },
  {
    title: "Capability-gated configs",
    body: "Timeouts, OAuth scopes, and tool auto-approval are mapped to each client's native mechanism — and dropped with a warning where unsupported.",
  },
  {
    title: "List, remove, sync",
    body: "Inspect installed servers across agents, remove them everywhere, or unify names and configs with a single sync.",
  },
  {
    title: "Free and open source",
    body: "Apache-2.0 licensed, no accounts, no telemetry surprises. A registry you can self-host and a config format you own.",
  },
];

const examples = [
  {
    id: "remote",
    label: "Remote server",
    code: "npx add-mcp https://mcp.context7.com/mcp",
  },
  {
    id: "npm",
    label: "npm package",
    code: "npx add-mcp @modelcontextprotocol/server-postgres",
  },
  {
    id: "find",
    label: "Find in registry",
    code: "npx add-mcp find neon",
  },
];

// SoftwareApplication structured data for the home page. Blume emits JSON-LD
// for content pages automatically, but custom pages bring their own.
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "add-mcp",
  description: config.description,
  url: config.site,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Linux, Windows",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  softwareHelp: `${config.site}/docs`,
  downloadUrl: "https://www.npmjs.com/package/add-mcp",
  sameAs: [
    "https://github.com/neon-solutions/add-mcp",
    "https://www.npmjs.com/package/add-mcp",
  ],
});
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  fontCssVars={data.fontCssVars}
  themeMode={config.theme.mode}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  page={{
    title: "add-mcp — add MCP servers to your coding agents",
    description: config.description,
  }}
>
  <HeaderBadges slot="ask" />
  <script is:inline set:html={structuredData} type="application/ld+json" />
  <section class="mx-auto max-w-4xl px-6 pt-24 pb-20 text-center">
    <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      Add MCP servers to your coding agents with a single command.
    </h1>
    <p class="text-muted-foreground mx-auto mt-5 max-w-xl text-lg text-pretty">
      One CLI that writes the right config file, format, and fields for every
      agent.
    </p>
    <div class="mx-auto mt-8 max-w-2xl" data-install-tabs>
      <div
        aria-label="Install command examples"
        class="flex flex-wrap justify-center gap-0.5 sm:gap-1"
        role="tablist"
      >
        {
          examples.map((example, index) => (
            <button
              aria-controls={`install-panel-${example.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              class="text-muted-foreground aria-selected:bg-muted aria-selected:text-foreground hover:text-foreground rounded-t-lg px-1.5 py-1.5 text-xs font-medium whitespace-nowrap transition-colors sm:px-3 sm:text-sm"
              id={`install-tab-${example.id}`}
              role="tab"
              type="button"
            >
              {example.label}
            </button>
          ))
        }
      </div>
      {
        examples.map((example, index) => (
          <div
            aria-labelledby={`install-tab-${example.id}`}
            class:list={["bg-muted rounded-lg border", { hidden: index !== 0 }]}
            id={`install-panel-${example.id}`}
            role="tabpanel"
          >
            <div class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5">
              <code class="text-left font-mono text-sm break-all sm:text-base">
                {example.code}
              </code>
              <button
                aria-label={`Copy command: ${example.code}`}
                class="text-muted-foreground hover:text-foreground shrink-0 rounded-md border bg-transparent p-2 transition-colors"
                data-copy={example.code}
                type="button"
              >
                <svg
                  aria-hidden="true"
                  class="copy-icon"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                >
                  <rect height="13" rx="2" width="13" x="9" y="9" />
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                </svg>
                <svg
                  aria-hidden="true"
                  class="check-icon hidden"
                  fill="none"
                  height="16"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  width="16"
                >
                  <path d="M20 6 9 17l-5-5" />
                </svg>
              </button>
            </div>
          </div>
        ))
      }
    </div>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/docs/quickstart"
        class="bg-foreground text-background rounded-lg px-5 py-2.5 text-sm font-medium transition-opacity hover:opacity-90"
      >
        Get started
      </a>
      <a
        href="/registry"
        class="hover:bg-muted rounded-lg border px-5 py-2.5 text-sm font-medium transition-colors"
      >
        Browse the registry
      </a>
    </div>
  </section>

  <script is:inline>
    (() => {
      const root = document.querySelector("[data-install-tabs]");
      if (!root) return;

      const tabs = Array.from(root.querySelectorAll("[role='tab']"));
      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((other) => {
            other.setAttribute("aria-selected", String(other === tab));
            const panel = document.getElementById(
              other.getAttribute("aria-controls"),
            );
            if (panel) panel.classList.toggle("hidden", other !== tab);
          });
        });
      });

      root.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy);
          } catch {
            return;
          }
          button.querySelector(".copy-icon")?.classList.add("hidden");
          button.querySelector(".check-icon")?.classList.remove("hidden");
          setTimeout(() => {
            button.querySelector(".copy-icon")?.classList.remove("hidden");
            button.querySelector(".check-icon")?.classList.add("hidden");
          }, 1500);
        });
      });
    })();
  </script>

  <section class="border-y">
    <div class="mx-auto max-w-4xl px-6 py-10 text-center">
      <p class="text-sm font-semibold">Works with every major coding agent</p>
      <p
        class="text-muted-foreground mx-auto mt-2 max-w-2xl text-sm text-pretty"
      >
        add-mcp installs any MCP server into Claude Code, Codex, Cursor,
        OpenCode, VS Code, and 10 more coding agents from the same command.
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
        {
          agentNames.map((name) => (
            <span class="text-muted-foreground rounded-full border px-3 py-1 text-sm">
              {name}
            </span>
          ))
        }
      </div>
      <a
        href="/docs/agents"
        class="text-foreground mt-4 inline-block text-sm underline underline-offset-4"
      >
        See all supported agents and config paths
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-20">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((feature) => (
          <div>
            <h2 class="text-base font-semibold">{feature.title}</h2>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              {feature.body}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-24 text-center">
    <h2 class="text-2xl font-semibold tracking-tight">
      In your own tool, too
    </h2>
    <p class="text-muted-foreground mx-auto mt-3 max-w-2xl text-pretty">
      The same package is a TypeScript SDK — detect a user's agents and install
      your MCP server for them in a few lines.
    </p>
    <pre
      class="bg-muted mt-6 overflow-x-auto rounded-xl border p-5 text-left font-mono text-sm leading-relaxed"><code>{`import { upsertServer } from "add-mcp";

upsertServer(
  "cursor",
  "context7",
  { type: "http", url: "https://mcp.context7.com/mcp" },
  { local: true },
);`}</code></pre>
    <a
      href="/docs/sdk"
      class="text-foreground mt-6 inline-block text-sm underline underline-offset-4"
    >
      Read the SDK docs
    </a>
  </section>

  <Footer slot="footer" />
</PageLayout>
